# Monorepo MES env.js (envsubst) — keys match apps/plantsuite-mes/src/assets/env.template.js
ENVIRONMENT=Development
appsettings_AuthConfig__Issuer=https://account.plantsuite.local/realms/plantsuite
appsettings_AuthConfig__ClientId=ps-iot-portal
appsettings_AuthConfig__Scope=openid profile email
appsettings_ApiUrl__Production=https://production.plantsuite.local/api/v1
appsettings_ApiUrl__Tenants=https://tenants.plantsuite.local/api/v1
appsettings_ApiUrl__ControlStation=https://controlstations.plantsuite.local/
appsettings_ApiUrl__Wd=https://wd.plantsuite.local/api/v1
# Browser WSS; User is tenant-prefixed (VerneMQ). Password from deployment secretKeyRef.
appsettings_Mqtt__Hostname=mqtt.plantsuite.local
appsettings_Mqtt__Port=443
appsettings_Mqtt__Path=mqtt
appsettings_Mqtt__Protocol=wss
appsettings_Mqtt__User=
